/*
	The game's shared RmlUi styles (the "modern" look). One dp is 1/1024 of the
	window's width (RmlUiHost::Resize), so the layout scales with the window
	the way the classic 1024-wide grid does, while text renders at the
	window's own resolution.

	RmlUi has no built-in element styles: every element used is given its
	display here.
*/

body, div, p, span {
	font-family: LatoLatin;
}

body {
	display: block;
	width: 100%;
	height: 100%;
	margin: 0;
	padding: 0;
	font-size: 15dp;
	font-weight: normal;
	color: #d6e4d8;
}

div, p { display: block; }
span { display: inline; }

/* -- Panels and controls -- */

.panel {
	position: absolute;
	background-color: #07130ef5;
	border: 1dp #3fd27a55;
	border-radius: 6dp;
	padding: 10dp 12dp;
}

.button {
	display: inline-block;
	padding: 5dp 12dp;
	border: 1dp #3fd27a66;
	border-radius: 4dp;
	background-color: #0b1f16cc;
	color: #bfe9cf;
	font-weight: bold;
	transition: background-color color 0.12s linear-in-out;
}
.button:hover {
	background-color: #3fd27a40;
	color: #ffffff;
}
.button:active {
	background-color: #3fd27a80;
}

/* -- Scroll bars (lists and long text) -- */

scrollbarvertical {
	width: 8dp;
	margin-left: 4dp;
}
scrollbarvertical slidertrack {
	background-color: #ffffff0d;
	border-radius: 4dp;
}
scrollbarvertical sliderbar {
	background-color: #3fd27a88;
	border-radius: 4dp;
	min-height: 24dp;
}
scrollbarvertical sliderbar:hover {
	background-color: #3fd27acc;
}
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc {
	height: 0;
}

/* -- The ship library -- */

#header {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	height: 52dp;
	padding: 0 16dp;
	background-color: #040b08e6;
	border-bottom: 1dp #3fd27a44;
}

#title {
	position: absolute;
	left: 16dp;
	top: 13dp;
	font-size: 22dp;
	font-weight: bold;
	color: #3fd27a;
	letter-spacing: 1dp;
}

#categories {
	position: absolute;
	left: 260dp;
	right: 120dp;
	top: 11dp;
	text-align: center;
}

#category {
	display: inline-block;
	min-width: 170dp;
	padding: 4dp 10dp;
	font-size: 19dp;
	font-weight: bold;
	color: #f2c94c;
}

.category-step {
	font-size: 13dp;
	font-weight: normal;
}

#back {
	position: absolute;
	right: 16dp;
	top: 11dp;
}

#list {
	left: 16dp;
	top: 68dp;
	bottom: 16dp;
	width: 250dp;
	padding: 6dp;
}

/* Scrolls inside the rounded panel; no rounding of its own, so RmlUi clips it
   with a scissor rectangle rather than a stencil mask. */
#ship-scroll {
	height: 100%;
	overflow-y: auto;
}

.ship {
	padding: 6dp 10dp;
	border-left: 3dp #00000000;
	color: #c9d8cc;
	transition: background-color 0.1s linear-in-out;
}
.ship:hover {
	background-color: #ffffff14;
	color: #ffffff;
}
.ship.shown {
	color: #ffffff;
	font-weight: bold;
}
.ship.selected {
	background-color: #f2c94c2e;
	border-left-color: #f2c94c;
	color: #ffe08a;
}

#sheet {
	left: 282dp;
	right: 16dp;
	bottom: 16dp;
	height: 162dp;
	display: flex;
	flex-direction: row;
}

#sheet-main {
	flex: 2.7 1 0;
	margin-right: 16dp;
}

#ship-name {
	font-size: 26dp;
	font-weight: bold;
	color: #ffffff;
}

#summary {
	margin: 2dp 0 8dp 0;
	color: #a8c7b2;
}

.tag {
	padding: 1dp 6dp;
	margin-right: 6dp;
	border-radius: 3dp;
	background-color: #3fd27a33;
	color: #3fd27a;
	font-size: 12dp;
	font-weight: bold;
}

#stats {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}

.stat {
	box-sizing: border-box;
	width: 33.3%;
	padding: 3dp 8dp 3dp 0;
	font-size: 12.5dp;
	color: #d6e4d8;
}

#description {
	flex: 1.25 1 0;
	height: 100%;
	overflow-y: auto;
	padding-right: 4dp;
	font-size: 13dp;
	line-height: 1.35em;
	color: #b9cbbd;
}

#hint {
	position: absolute;
	right: 20dp;
	top: 58dp;
	text-align: right;
	font-size: 12dp;
	color: #7f9a88;
}
