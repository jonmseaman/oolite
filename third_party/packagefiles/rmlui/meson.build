rmlui_core_lib = static_library('rmlui_core',
    rmlui_core_sources,
    include_directories: [rmlui_inc, include_directories('Source/Core')],
    cpp_args: [
        '-DRMLUI_STATIC_LIB',
        '-DRMLUI_FONT_ENGINE_FREETYPE',
        '-DRMLUI_VERSION="' + meson.project_version() + '"',
    ],
    dependencies: [freetype_dep],
    install: false,
)

rmlui_dep = declare_dependency(
    include_directories: rmlui_inc,
    compile_args: ['-DRMLUI_STATIC_LIB'],
    link_with: rmlui_core_lib,
)

if host_machine.system() == 'darwin'
    rmlui_gl_dep = dependency('appleframeworks', modules: ['OpenGL'])
elif host_machine.system() == 'windows'
    rmlui_gl_dep = meson.get_compiler('cpp').find_library('opengl32')
else
    rmlui_gl_dep = dependency('gl')
endif

# The renderer includes <OpenGL/gl.h> (macOS), <GL/gl.h> or <gl/Gl.h>. On macOS it takes the
# game's own GL_SILENCE_DEPRECATION (src/meson/darwin), as every GL user in the game does.
rmlui_gl2_args = ['-DRMLUI_STATIC_LIB']
if host_machine.system() == 'darwin'
    rmlui_gl2_args += ['-DGL_SILENCE_DEPRECATION']
endif
rmlui_gl2_lib = static_library('rmlui_gl2',
    files('Backends/RmlUi_Renderer_GL2.cpp'),
    include_directories: [rmlui_inc, include_directories('Backends')],
    cpp_args: rmlui_gl2_args,
    dependencies: [rmlui_gl_dep],
    install: false,
)

rmlui_gl2_dep = declare_dependency(
    include_directories: include_directories('Backends'),
    link_with: rmlui_gl2_lib,
    dependencies: [rmlui_dep, rmlui_gl_dep],
)

meson.override_dependency('rmlui', rmlui_dep)
meson.override_dependency('rmlui-gl2', rmlui_gl2_dep)
