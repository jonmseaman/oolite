# Oolite's meson build of RmlUi 6.3 (third_party/rmlui.wrap): the core library with its default
# FreeType font engine, and the OpenGL 2 renderer from Backends/, which draws through the game's
# legacy (compatibility) GL context. No debugger, Lua, SVG or Lottie plugins, no samples.
# The source list is RmlUi's own (Source/Core/CMakeLists.txt and its subdirectories).
project('rmlui', 'cpp',
    version: '6.3',
    license: 'MIT',
    default_options: ['cpp_std=c++17', 'default_library=static'],
)

freetype_dep = dependency('freetype2')

rmlui_inc = include_directories('Include')

rmlui_core_sources = files(
    'Source/Core/BaseXMLParser.cpp',
    'Source/Core/Box.cpp',
    'Source/Core/BoxShadowCache.cpp',
    'Source/Core/CallbackTexture.cpp',
    'Source/Core/Clock.cpp',
